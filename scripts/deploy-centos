#!/usr/bin/env python3
"""Back up and replace the deployed WAR, then wait for the application."""
from __future__ import annotations

import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.request import urlopen

WAR_NAME = "announcement-board.war"
REPOSITORY_WAR = Path(__file__).resolve().parent.parent / "target" / WAR_NAME
WEBAPPS_DIR = Path("/var/lib/tomcat/webapps")
DEPLOYED_WAR = WEBAPPS_DIR / WAR_NAME
STAGING_WAR = WEBAPPS_DIR / f"{WAR_NAME}.deploying"
EXPLODED_DIR = WEBAPPS_DIR / "announcement-board"
BACKUP_DIR = Path("/var/backups/announcement-board")
TOMCAT_SERVICE = "tomcat"
APPLICATION_URL = "http://127.0.0.1:8080/announcement-board/"
READY_TIMEOUT_SECONDS = 90
READY_POLL_SECONDS = 1


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(args, check=check)


def sudo(*args: str, check: bool = True) -> subprocess.CompletedProcess[bytes]:
    return run("sudo", "-n", *args, check=check)


def backup_previous_war() -> Path | None:
    if sudo("test", "-f", str(DEPLOYED_WAR), check=False).returncode != 0:
        print("backup: no previous WAR")
        return None

    sudo("install", "-d", "-m", "0750", "-o", "root", "-g", "root", str(BACKUP_DIR))
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = BACKUP_DIR / f"announcement-board.{stamp}.war.bak"
    sudo(
        "install",
        "-m",
        "0640",
        "-o",
        "root",
        "-g",
        "root",
        str(DEPLOYED_WAR),
        str(backup),
    )
    print(f"backup={backup}")
    return backup


def replace_war() -> None:
    print("stopping tomcat")
    sudo("systemctl", "stop", TOMCAT_SERVICE)
    sudo("rm", "-rf", "--", str(EXPLODED_DIR))
    sudo("rm", "-f", "--", str(STAGING_WAR))
    sudo(
        "install",
        "-m",
        "0644",
        "-o",
        "tomcat",
        "-g",
        "tomcat",
        str(REPOSITORY_WAR),
        str(STAGING_WAR),
    )
    sudo("mv", "-f", "--", str(STAGING_WAR), str(DEPLOYED_WAR))
    print(f"installed {DEPLOYED_WAR}")
    print("starting tomcat")
    sudo("systemctl", "start", TOMCAT_SERVICE)


def wait_until_ready() -> None:
    deadline = time.monotonic() + READY_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        try:
            with urlopen(APPLICATION_URL, timeout=3) as response:
                if response.status == 200:
                    print(f"server is up: {APPLICATION_URL}")
                    return
        except Exception:
            pass
        time.sleep(READY_POLL_SECONDS)
    raise RuntimeError(
        f"server did not return HTTP 200 within {READY_TIMEOUT_SECONDS}s: "
        f"{APPLICATION_URL}"
    )


def main(argv: list[str]) -> int:
    if argv[1:] in (["-h"], ["--help"]):
        print("usage: deploy-centos")
        print(f"deploys the existing artifact at {REPOSITORY_WAR}")
        return 0
    if argv[1:]:
        print("usage: deploy-centos", file=sys.stderr)
        return 2

    try:
        backup_previous_war()
        replace_war()
        wait_until_ready()
        return 0
    except (OSError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"deploy-centos: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
